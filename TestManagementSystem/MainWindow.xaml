        </Grid> 

        <Border Grid.Row="2" Grid.ColumnSpan="2" 
            BorderThickness="0,1,0,0" BorderBrush="{StaticResource BackgroundPrimaryBrush}" Background="{StaticResource BackgroundSecondaryBrush}">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Last Access: " 
                    
                        Foreground="{StaticResource ForegroundSecondaryBrush}"/>
                    <TextBlock x:Name="LastAccessedTimeTextBlock" 
                               Text="[Loading...]" 
     
                               Foreground="{StaticResource ForegroundSecondaryBrush}"/>
                </StackPanel>

                <TextBlock x:Name="CurrentTimeTextBlock" 
                    
                           Text="[Loading...]" 
                           HorizontalAlignment="Right" 
                           VerticalAlignment="Center"
                           Foreground="{StaticResource ForegroundSecondaryBrush}"/>

            </Grid>
        </Border>
    </Grid>
</Window>