<Window x:Class="TestManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Test Management System - AH64" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Color x:Key="BackgroundPrimaryColor">#1E1E1E</Color>
        <Color x:Key="BackgroundSecondaryColor">#2D2D30</Color>

        <Color x:Key="AccentColor">#4CAF50</Color>
        <Color x:Key="AccentHoverColor">#409744</Color>
        <Color x:Key="ForegroundColor">#F0F0F0</Color>
        <Color x:Key="ForegroundSecondaryColor">#AAAAAA</Color>
        <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimaryColor}"/>
        <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondaryColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
        <SolidColorBrush x:Key="ForegroundSecondaryBrush" 
            Color="{StaticResource ForegroundSecondaryColor}"/>

        <Style x:Key="RowDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="15,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="Margin" Value="15,9"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}" 
                               
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource BackgroundPrimaryBrush}"/>
                                <Setter Property="RenderTransform">

                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>

                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource BackgroundPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="30"/>

            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>

            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BackgroundPrimaryBrush}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>

            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BackgroundSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" 
                Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Direction="270" Opacity="0.3" BlurRadius="5" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BackgroundPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BackgroundSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource BackgroundPrimaryBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BackgroundSecondaryBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BackgroundSecondaryBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BackgroundSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <DataTemplate x:Key="AllTestsDashboardTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="All Test Events" 
                           FontSize="24" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"
                           Foreground="{StaticResource ForegroundBrush}"/>

                    <Button Grid.Column="1" 
                            Content="Home (Summary)"
                            Background="{StaticResource BackgroundSecondaryBrush}"
                            Foreground="{StaticResource AccentBrush}"
                            FontWeight="SemiBold"
                            Padding="10,5"
                            Click="GoToSummaryDashboardClick"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Filter by Status:" VerticalAlignment="Center" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="0,0,5,0"/>
                    <ComboBox x:Name="StatusFilterComboBox" SelectedIndex="0" Width="100" Margin="0,0,15,0" SelectionChanged="FilterDataGrid">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Open"/>
                        <ComboBoxItem Content="Closed"/>
                    </ComboBox>

                    <TextBlock Text="Filter by Type:" VerticalAlignment="Center" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="0,0,5,0"/>
                    <ComboBox x:Name="TypeFilterComboBox" SelectedIndex="0" Width="120" Margin="0,0,15,0" SelectionChanged="FilterDataGrid">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="DR Recheck"/>
                        <ComboBoxItem Content="V&amp;V"/>
                        <ComboBoxItem Content="Accreditation"/>
                        <ComboBoxItem Content="Upgrade"/>
                        <ComboBoxItem Content="Government"/>
                        <ComboBoxItem Content="SPA/CEVT"/>
                    </ComboBox>

                    <TextBlock Text="Filter by Date (After):" VerticalAlignment="Center" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="0,0,5,0"/>
                    <DatePicker x:Name="DateFilterPicker" Width="120" SelectedDateFormat="Short" SelectedDateChanged="FilterDataGrid"/>
                    
                    <!-- New Button for Exporting to CSV -->
                    <Button Content="Export to CSV" Margin="20,0,10,0"
                            Background="{StaticResource AccentBrush}" Foreground="{StaticResource ForegroundBrush}"
                            Click="ExportToCsvClick"/>


                    <Button Content="Clear Filters" Margin="10,0,0,0" Click="ClearFiltersClick"/>

                </StackPanel>

                <DataGrid x:Name="AllTestsDataGrid" 
                          ItemsSource="{Binding}"
                          IsReadOnly="True"
                          MaxHeight="500"
                          VerticalScrollBarVisibility="Auto"
                          MouseDoubleClick="AllTestsDataGrid_MouseDoubleClick">
                    
                   
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Test #" Binding="{Binding TestNumber, StringFormat=T-{0:D3}}" Width="Auto"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding TestTitle}" Width="2*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding TestType}" Width="*"/>
                        <DataGridTextColumn Header="Start Date" Binding="{Binding DateStart, StringFormat={}{0:yyyy-MM-dd}}" Width="*"/>

                        <DataGridTextColumn Header="DRs" Binding="{Binding DRCount}" Width="Auto"/>
                        <DataGridTextColumn Header="Issues" Binding="{Binding IssueCount}" Width="Auto"/>
                        <DataGridTextColumn Header="RedLines" Binding="{Binding RedLineCount}" Width="Auto"/>

                        <DataGridTemplateColumn Header="Status" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" 
                                               Foreground="{Binding StatusColorBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="# Comments" Binding="{Binding CommentCount}" Width="Auto"/>

                        <DataGridTemplateColumn Header="Actions" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Delete" 
                                            Style="{StaticResource RowDeleteButtonStyle}"
                                            Tag="{Binding TestNumber}"
                                            Click="DeleteTestButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Double-click a row to open Test Details." 
                           Foreground="{StaticResource ForegroundSecondaryBrush}" 
                           Margin="0,20,0,0" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SummaryDashboardTemplate">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Testing Dashboard Summary" 
                           FontSize="24" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,20"
                           Foreground="{StaticResource ForegroundBrush}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                        <StackPanel>
                            <TextBlock Text="DRs (Defect Reports)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding OpenDRsTotal}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Total Open" Margin="0,0,0,10" Foreground="{StaticResource ForegroundSecondaryBrush}"/>
                            <StackPanel Margin="0,5,0,0">
                                <TextBlock Text="{Binding Priority1DRs}" Foreground="{StaticResource ForegroundBrush}" />
                                <TextBlock Text="{Binding Priority2DRs}" Foreground="{StaticResource ForegroundBrush}" />
                                <TextBlock Text="... (P3, P4, P5 details will appear here)" Foreground="{StaticResource ForegroundSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Issues" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding OpenIssuesTotal}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Total Open" Margin="0,0,0,10" Foreground="{StaticResource ForegroundSecondaryBrush}"/>
                            <StackPanel Margin="0,5,0,0">
                                <TextBlock Text="{Binding TrackIssues}" Foreground="{StaticResource ForegroundBrush}" />
                                <TextBlock Text="{Binding ResearchIssues}" Foreground="{StaticResource ForegroundBrush}" />
                                <TextBlock Text="... (Other Issue types will appear here)" Foreground="{StaticResource ForegroundSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                        <StackPanel>
                            <TextBlock Text="RedLines" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding OpenRedlinesTotal}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Total Open" Margin="0,0,0,10" Foreground="{StaticResource ForegroundSecondaryBrush}"/>
                            <TextBlock Text="Placeholder for Redline details" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="This area will display detailed test data and filters once the backend is connected."
                           Foreground="{StaticResource ForegroundSecondaryBrush}"
                           Margin="0,40,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Grid Background="{StaticResource 
        BackgroundPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BackgroundSecondaryBrush}" Background="{StaticResource BackgroundSecondaryBrush}">

            <Grid>
                <TextBlock Text="Test Management System - AH64" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left" 
             
                           Margin="20,0,0,0" 
                           FontSize="18" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ForegroundBrush}"/>


                <Button Content="i"
                        Foreground="#AAAAAA"
                        Click="InfoButton_Click"
               
                        FontSize="25"
                        Style="{StaticResource InfoButtonStyle}" 
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                 
                        VerticalAlignment="Center">


                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="0" Background="{StaticResource BackgroundSecondaryBrush}" Margin="0,0,1,0">

            <Button x:Name="StartNewTestButton"
                    Margin="10,20,10,20"
                    Padding="15,10"
                   
                    BorderThickness="0"
                    Background="{StaticResource AccentBrush}"
                    Click="OnStartNewTestClick">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="25"/>
                    </Style>
                </Button.Resources>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">

                    <TextBlock x:Name="PlusIcon" 
                               Text="+" 
                               FontSize="20" 
                         
                               FontWeight="Bold" 
                               Margin="0,0,5,0"
                               VerticalAlignment="Center"
                               
                               Foreground="White"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="PlusScale"/>

                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="Start New Test" 
                               FontSize="14" 
                
                               FontWeight="SemiBold" 
                               VerticalAlignment="Center"
                               Foreground="White"/>
                </StackPanel>


                <Button.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>

                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="StartNewTestButton" 
                                                Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
         
                                                To="{StaticResource AccentHoverColor}" Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetName="PlusScale" 
                         
                                                 Storyboard.TargetProperty="ScaleX" To="1.2" Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetName="PlusScale" 
                                        
                                                 Storyboard.TargetProperty="ScaleY" To="1.2" Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="StartNewTestButton" 
          
                                                Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                                To="{StaticResource AccentColor}" Duration="0:0:0.1"/>

                                <DoubleAnimation Storyboard.TargetName="PlusScale" 
                                                 Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.1"/>

                                <DoubleAnimation Storyboard.TargetName="PlusScale" 
                                                 Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.1"/>
                            </Storyboard>

                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>

            <Separator Background="{StaticResource ForegroundSecondaryBrush}" Opacity="0.2" Margin="10,5"/>

            <Button Style="{StaticResource NavMenuItemStyle}" Click="OnNavButtonClick" Tag="Dashboard">
                <TextBlock Text="Testing Dashboard"/>
            </Button>
            <Button Style="{StaticResource NavMenuItemStyle}" Click="OnNavButtonClick" Tag="DRs" VerticalAlignment="Top">
                <TextBlock Text="DRs"/>
            </Button>
            <Button Style="{StaticResource NavMenuItemStyle}" Click="OnNavButtonClick" Tag="Issues">

                <TextBlock Text="Issues"/>
            </Button>
            <Button Style="{StaticResource NavMenuItemStyle}" Click="OnNavButtonClick" Tag="RedLines">
                <TextBlock Text="RedLines"/>
            </Button>
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="1" Margin="20">
            <ContentControl x:Name="DashboardContentArea"
                            Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            ContentTemplate="{StaticResource SummaryDashboardTemplate}"/>
