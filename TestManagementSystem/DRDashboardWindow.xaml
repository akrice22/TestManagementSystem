<Window x:Class="TestManagementSystem.DRDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DR Tracking Dashboard" Height="700" Width="1200"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Color x:Key="BackgroundPrimaryColor">#1E1E1E</Color>
        <Color x:Key="BackgroundSecondaryColor">#2D2D30</Color>
        <Color x:Key="AccentColor">#4CAF50</Color>
        <Color x:Key="ForegroundColor">#F0F0F0</Color>
        <Color x:Key="ForegroundSecondaryColor">#AAAAAA</Color>

        <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimaryColor}"/>
        <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondaryColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
        <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="{StaticResource ForegroundSecondaryColor}"/>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BackgroundPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="RowBackground" Value="{StaticResource BackgroundPrimaryBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BackgroundSecondaryBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BackgroundSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        
        
        
        
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundPrimaryBrush}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DR Tracking Dashboard (Defect Reports)" 
                   FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Status:" VerticalAlignment="Center" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="0,0,5,0"/>
            <ComboBox x:Name="StatusFilterComboBox" SelectedIndex="0" Width="100" Margin="0,0,15,0" SelectionChanged="HandleFilterChange">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Open"/>
                <ComboBoxItem Content="Closed"/>
            </ComboBox>

            <TextBlock Text="Priority:" VerticalAlignment="Center" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="0,0,5,0"/>
            <ComboBox x:Name="PriorityFilterComboBox" SelectedIndex="0" Width="100" Margin="0,0,15,0" SelectionChanged="HandleFilterChange">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="P1"/>
                <ComboBoxItem Content="P2"/>
                <ComboBoxItem Content="P3"/>
                <ComboBoxItem Content="P4"/>
                <ComboBoxItem Content="P5"/>
            </ComboBox>

            <TextBlock Text="Test #:" VerticalAlignment="Center" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="0,0,5,0"/>
            <TextBox x:Name="TestNumberFilterTextBox" Width="80" Margin="0,0,15,0" TextChanged="HandleFilterChange"/>

            <TextBlock Text="Date Range (Start):" VerticalAlignment="Center" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="0,0,5,0"/>
            <DatePicker x:Name="StartDateFilterPicker" Width="120" SelectedDateFormat="Short" SelectedDateChanged="HandleFilterChange"/>

            <TextBlock Text="Date Range (End):" VerticalAlignment="Center" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="15,0,5,0"/>
            <DatePicker x:Name="EndDateFilterPicker" Width="120" SelectedDateFormat="Short" SelectedDateChanged="HandleFilterChange"/>

            <Button Content="Clear Filters" Margin="20,0,0,0" Click="ClearFiltersClick"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="DRsDataGrid" ItemsSource="{Binding}" VerticalScrollBarVisibility="Auto" RowDetailsVisibilityMode="VisibleWhenSelected" IsReadOnly="True">
            <DataGrid.Columns>

                <DataGridTextColumn Header="DR #" Binding="{Binding DRNumber}" Width="70"/>
                <DataGridTextColumn Header="Test #" Binding="{Binding TestNumber, StringFormat=T-{0:D3}}" Width="70"/>
                <DataGridTextColumn Header="Test Title" Binding="{Binding TestTitle}" Width="1.5*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80"/>
                <DataGridTextColumn Header="Date Opened" Binding="{Binding DateOpened, StringFormat={}{0:yyyy-MM-dd}}" Width="*"/>
                <DataGridTextColumn Header="Closed Date" Binding="{Binding DateClosedOrMoved}" Width="*"/>
                <DataGridTextColumn Header="Origin" Binding="{Binding OriginatingIssueStatus}" Width="*"/>

                <DataGridTextColumn Header="Latest Comment" Binding="{Binding LatestCommentText}" Width="2*"/>

                <DataGridTemplateColumn Header="Action" Width="50"></DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <StackPanel Margin="20">
                        <TextBlock Text="--- DR History and Updates ---" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundSecondaryBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}"
                                                       Text="{Binding Title, StringFormat=Comment: {0}}"/>
                                            <TextBlock Foreground="{StaticResource ForegroundSecondaryBrush}"
                                                       Text="{Binding CreatedTimestamp, StringFormat=Opened: {0:yyyy-MM-dd HH:mm}}"/>
                                           
                                            <TextBlock Foreground="{StaticResource ForegroundSecondaryBrush}" Text="{Binding LastUpdatedDisplay}"/>
                                            <TextBlock Foreground="{StaticResource ForegroundSecondaryBrush}"
                                                       Text="{Binding Description, StringFormat=Description: {0}}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Status, StringFormat=DR Status: {0} (Priority: {1})}" 
                                                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,5,0,0"/>

                                            <ItemsControl ItemsSource="{Binding SubComments}" Margin="10,5,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock TextWrapping="Wrap"
                                                                   Foreground="{StaticResource ForegroundSecondaryBrush}" FontSize="11" Margin="0,0,0,2">
                                                            <Run Text="["/>
                                                            <Run Text="{Binding Text}"/>
                                                            <Run Text="]"/>
                                                            <Run Text=" ("/>
                                                            <Run Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                                                            <Run Text=")"/>
                                                        </TextBlock>
                                                        <!--<TextBlock Text="{Binding Text, StringFormat=[{0}]}"
                                                                   Foreground="{StaticResource ForegroundSecondaryBrush}" FontSize="11"/> -->
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl> 
                    </StackPanel>
                </DataTemplate>
                
            </DataGrid.RowDetailsTemplate>

          
                        
        </DataGrid>
    </Grid>
</Window>