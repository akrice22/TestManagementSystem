<Window x:Class="TestManagementSystem.TestDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Test Details" Height="600" Width="700"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Color x:Key="BackgroundPrimaryColor">#1E1E1E</Color>
        <Color x:Key="AccentColor">#4CAF50</Color>
        <Color x:Key="ForegroundColor">#F0F0F0</Color>
		<Color x:Key="BackgroundSecondaryColor">#2D2D30</Color>
		<Color x:Key="ForegroundSecondaryColor">#AAAAAA</Color>

        <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimaryColor}"/>
		<SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondaryColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
		<SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="{StaticResource ForegroundSecondaryColor}"/>

        <Style TargetType="TextBlock" x:Key="DetailLabelStyle">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>

		<Style TargetType="TextBlock" x:Key="DetailValueStyle">
			<Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
			<Setter Property="FontSize" Value="16"/>
		</Style>
        
        

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#E53935"/>
                </Setter.Value>
            </Setter>
        </Style>
		
		<!-- New Style for DR Recheck -->
		<Style x:Key="RecheckCommentBoxStyle" TargetType="TextBox">
			<Setter Property="Background" Value="#383838"/>
			<Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
			<Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Height" Value="40"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="AcceptsReturn" Value="True"/>
		</Style>
		
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundPrimaryBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="5,0,0,20">
            <TextBlock x:Name="HeaderTestNumber" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock x:Name="HeaderTestTitle" FontSize="18" Foreground="{StaticResource ForegroundBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<!-- Added <StackPanel> -->
			<StackPanel>
				
            <Grid Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0">
                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Test Start Date:" Margin="5,0,0,0"/>
                    <TextBlock x:Name="DateStartTextBlock" Style="{StaticResource DetailValueStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0">
                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Test End Date:"/>
                    <TextBlock x:Name="DateEndTextBlock" Style="{StaticResource DetailValueStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="0">
                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Test Type Detail:"/>
                    <TextBlock x:Name="TestTypeDetailTextBlock" Style="{StaticResource DetailValueStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1">
                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Load Number:"/>
                    <TextBlock x:Name="LoadNumberTextBlock" Style="{StaticResource DetailValueStyle}"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Grid.Row="1">
                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="System:"/>
                    <TextBlock x:Name="SystemTextBlock" Style="{StaticResource DetailValueStyle}"/>
                </StackPanel>



                <StackPanel Grid.Column="2" Grid.Row="1">
                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Test Type:"/>
                    <TextBlock x:Name="TestTypeTextBlock" Style="{StaticResource DetailValueStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Grid.Row="2">
                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Devices Tested:"/>
                    <TextBlock x:Name="DevicesTestedTextBlock" Style="{StaticResource DetailValueStyle}"/>
                </StackPanel>

                <StackPanel Grid.ColumnSpan="3" Grid.Row="3" Margin="0,20,0,0">
                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Test Description:"/>
                    <TextBlock x:Name="DescriptionTextBlock" TextWrapping="Wrap" Foreground="{StaticResource ForegroundBrush}"/>
                </StackPanel>

                <!--<StackPanel Grid.ColumnSpan="3" Grid.Row="4" Margin="0,20,0,0">
                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Comments/Results:"/>
                    <StackPanel x:Name="CommentsStackPanel" Margin="3,5,0,3"/>
                </StackPanel>-->

            </Grid>
			
			<!-- New Code for DRs -->
				<StackPanel x:Name="DRRecheckPanel" Visibility="Collapsed" Margin="0,30,0,0">
					<TextBlock Text="--- DR Recheck List ---"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="8,0,0,10"/>

					<ItemsControl x:Name="DRRecheckItemsControl" ItemsSource="{Binding RecheckItems}" Margin="8,0,8,0">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border BorderBrush="{StaticResource BackgroundSecondaryBrush}" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,15">
									<StackPanel>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>

											<StackPanel Grid.Column="0">
												<TextBlock Text="{Binding GlobalDRNumber, StringFormat=DR \#: {0}}" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}"/>
												<TextBlock Text="{Binding DateCreated, StringFormat=Created: {0:yyyy-MM-dd}}" Foreground="{StaticResource ForegroundSecondaryBrush}"/>
												<TextBlock Text="{Binding LatestStatus, StringFormat=Status: {0} ({1})}"
                                                           Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"/>
											</StackPanel>

											<StackPanel Grid.Column="1" Margin="20,0,0,0">
												<TextBlock Text="{Binding LatestDescription, StringFormat=Description: {0}}" TextWrapping="Wrap" Foreground="{StaticResource ForegroundSecondaryBrush}"/>
												<TextBlock Text="{Binding OriginatingTestNumber, StringFormat=Originated from Test T-{0:D3}}" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" Margin="0,5,0,0"/>
											</StackPanel>

											<StackPanel Grid.Column="2" Margin="10,0,0,0">
												<TextBlock Text="Recheck Comment:" Foreground="{StaticResource ForegroundSecondaryBrush}"/>
												<TextBox Text="{Binding RecheckComment}"
                                                         x:Name="RecheckCommentTextBox"
                                                         Style="{StaticResource RecheckCommentBoxStyle}"/>
											</StackPanel>
                                               <!-- NEW -->
											<StackPanel Grid.Column="3" Margin="10,0,0,0">
												<TextBlock Text="Update Priority:" Foreground="{StaticResource ForegroundSecondaryBrush}"/>
												<ComboBox x:Name="NewPriorityComboBox" Width="100" SelectedItem="{Binding LatestPriority}">
													<ComboBoxItem Content="P1"/>
													<ComboBoxItem Content="P2"/>
													<ComboBoxItem Content="P3"/>
													<ComboBoxItem Content="P4"/>
													<ComboBoxItem Content="P5"/>
												</ComboBox>

												<CheckBox x:Name="CloseDRCheckBox" Content="Close DR"
                                                          IsChecked="{Binding IsDRClosedForRecheck}"
                                                          Foreground="{StaticResource ForegroundBrush}" Margin="0,10,0,0"/>
											</StackPanel>
										</Grid>

										<TextBlock Text="Original DR History:" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="0,15,0,5"/>
										<ItemsControl ItemsSource="{Binding OriginalSubComments}" Margin="10,0,0,0">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<TextBlock Text="{Binding Text, StringFormat=[{0}]}" FontSize="11" Foreground="{StaticResource ForegroundSecondaryBrush}"/>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>

				<StackPanel Margin="0,20,0,0">
					<TextBlock Style="{StaticResource DetailLabelStyle}" Text="Comments/Results:"/>
					<StackPanel x:Name="CommentsStackPanel" Margin="3,5,0,3"/>
				</StackPanel>
					
				
			</StackPanel>
        </ScrollViewer>


        <Grid Grid.Row="2" Margin="0,20,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Edit Test Details" 
                    Grid.Column="0"
                    x:Name="EditDetailsButton"
                    Background="#616161" 
                    Foreground="{StaticResource ForegroundBrush}" 
                    FontWeight="SemiBold"
                    Height="35"
                    Width="150"
                    Margin="0,0,10,0"/>

            <Button Content="Add New Comment" 
                    Grid.Column="1"
                    x:Name="AddCommentButton"
                    Background="{StaticResource AccentBrush}" 
                    Foreground="{StaticResource ForegroundBrush}" 
                    FontWeight="SemiBold"
                    Height="35"
                    Width="150"
                    Margin="0,0,10,0"
                    IsEnabled="True"/>

            <Button Content="Save Test Progress" 
                    Grid.Column="2"
                    x:Name="SaveProgressButton"
                    Background="#303030" 
                    Foreground="{StaticResource ForegroundBrush}" 
                    FontWeight="SemiBold"
                    Height="35"
                    Width="150"
                    Margin="0,0,10,0"/>

            <Button Content="End Test Event" 
                    Grid.Column="3"
                    x:Name="EndTestButton"
                    Background="#E53935" 
                    Foreground="{StaticResource ForegroundBrush}" 
                    FontWeight="SemiBold"
                    Height="35"
                    Width="150"
                    Margin="5,0,10,0"/>
        </Grid>
        
    </Grid>
</Window>