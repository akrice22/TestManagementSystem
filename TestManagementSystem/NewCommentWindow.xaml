<Window x:Class="TestManagementSystem.NewCommentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add New Test Comment" Height="650" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Color x:Key="BackgroundPrimaryColor">#1E1E1E</Color>
        <Color x:Key="BackgroundSecondaryColor">#2D2D30</Color>
        <Color x:Key="AccentColor">#4CAF50</Color>
        <Color x:Key="ForegroundColor">#F0F0F0</Color>
        <Color x:Key="ForegroundSecondaryColor">#AAAAAA</Color>
        <Color x:Key="BlackColor">#000000</Color>


        <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimaryColor}"/>
        <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondaryColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}"/>
        <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="{StaticResource ForegroundSecondaryColor}"/>
        <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource BlackColor}"/>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <!--<Setter Property="Foreground" Value="{StaticResource ForegroundSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>-->
        </Style>

        <Style TargetType="{x:Type Control}">
            <!--
            <Setter Property="Background" Value="{StaticResource BackgroundPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BackgroundPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>-->
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{StaticResource BackgroundSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BackgroundSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource BlackBrush}"/>
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{StaticResource BackgroundSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BackgroundSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        </Style>
        <!-- New -->
        <Style x:Key="AddCommentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundPrimaryBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Grid Margin="0,0,0,15">
                    <TextBlock x:Name="CommentNumberTextBlock" Text="Comment #N/A"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               FontSize="14" Foreground="{StaticResource ForegroundSecondaryBrush}"/>
                    <TextBlock x:Name="NewCommentHeaderTextBlock" Text="New Test Comment" 
                               HorizontalAlignment="Center"
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}"/>
                </Grid>

                <TextBlock Style="{StaticResource LabelStyle}" Text="Comment Title: *" Foreground="{StaticResource ForegroundSecondaryBrush}"/>
                <TextBox x:Name="CommentTitleTextBox" Height="30"/>

                <TextBlock Style="{StaticResource LabelStyle}" Text="Comment Description: *" Foreground="{StaticResource ForegroundSecondaryBrush}"/>
                <TextBox x:Name="DescriptionTextBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                <TextBlock Style="{StaticResource LabelStyle}" Text="Associated Item (Optional - Select one type):" 
                           FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" Margin="0,20,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0" Background="{StaticResource BackgroundSecondaryBrush}">
                        <CheckBox x:Name="DRCheckBox" Content="Defect Report (DR)" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10"
                                  Checked="AssociatedCheckBox_Checked" Unchecked="AssociatedCheckBox_Unchecked"/>

                        <TextBlock Text="Priority:" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="5,5,0,5"/>
                        <ComboBox x:Name="DRPriorityComboBox" IsEnabled="{Binding IsChecked, ElementName=DRCheckBox}" Margin="5,0,5,0">
                            <ComboBoxItem Content="P1 - Critical" Foreground="Black"/>
                            <ComboBoxItem Content="P2 - High" Foreground="Black"/>
                            <ComboBoxItem Content="P3 - Medium" Foreground="Black"/>
                            <ComboBoxItem Content="P4 - Low" Foreground="Black"/>
                            <ComboBoxItem Content="P5 - Informational" Foreground="Black"/>
                        </ComboBox>

                        <TextBlock Text="Status:" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="5,10,0,5"/>
                        <ComboBox x:Name="DRStatusComboBox" IsEnabled="{Binding IsChecked, ElementName=DRCheckBox}" SelectedIndex="0" Margin="5,0,5,0">
                            <ComboBoxItem Content="Open" Foreground="Black"/>
                            <ComboBoxItem Content="Closed" Foreground="Black"/>
                        </ComboBox>


                        <StackPanel x:Name="DRSubCommentPanel" Visibility="Collapsed">
                            <TextBlock Text="DR Comments:" Foreground="{StaticResource ForegroundBrush}" FontWeight="SemiBold" Margin="0,15,0,5"/>
                            <TextBox x:Name="DRSubCommentTextBox" Height="40" TextWrapping="Wrap" IsEnabled="{Binding IsChecked, ElementName=DRCheckBox}"/>

                            <Button Style="{StaticResource AddCommentButtonStyle}" Click="AddDRComment_Click" IsEnabled="{Binding IsChecked, ElementName=DRCheckBox}" Margin="0,5,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="Add New Comment" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <StackPanel x:Name="DRSubCommentList" />
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,5,0" Background="{StaticResource BackgroundSecondaryBrush}">
                        <CheckBox x:Name="IssueCheckBox" Content="Issue" Foreground="{StaticResource ForegroundBrush}" Margin="5,0,0,10"
                                  Checked="AssociatedCheckBox_Checked" Unchecked="AssociatedCheckBox_Unchecked"/>

                        <TextBlock Text="Status:" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="5,5,0,5"/>
                        <ComboBox x:Name="IssueStatusComboBox" IsEnabled="{Binding IsChecked, ElementName=IssueCheckBox}" SelectedIndex="0" Margin="5,0,5,0"
                                  SelectionChanged="IssueStatusComboBox_SelectionChanged">
                            <ComboBoxItem Content="Open" Foreground="Black"/>
                            <ComboBoxItem Content="Closed" Foreground="Black"/>
                            <ComboBoxItem Content="Research" Foreground="Black"/>
                            <ComboBoxItem Content="Track" Foreground="Black"/>
                            <ComboBoxItem Content="Moved to DR" Foreground="Black"/>
                        </ComboBox>

                        <StackPanel x:Name="IssueSubCommentPanel" Visibility="Collapsed">
                            <TextBlock Text="Issue Comments:" Foreground="{StaticResource ForegroundBrush}" FontWeight="SemiBold" Margin="0,15,0,5"/>
                            <TextBox x:Name="IssueSubCommentTextBox" Height="40" TextWrapping="Wrap" IsEnabled="{Binding IsChecked, ElementName=IssueCheckBox}"/>

                            <Button Style="{StaticResource AddCommentButtonStyle}" Click="AddIssueComment_Click" IsEnabled="{Binding IsChecked, ElementName=IssueCheckBox}" Margin="0,5,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="Add New Comment" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <StackPanel x:Name="IssueSubCommentList" />
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,0,0" Background="{StaticResource BackgroundSecondaryBrush}">
                        <CheckBox x:Name="RedLineCheckBox" Content="RedLine" Foreground="{StaticResource ForegroundBrush}" Margin="5,0,0,10"
                                  Checked="AssociatedCheckBox_Checked" Unchecked="AssociatedCheckBox_Unchecked"/>

                        <TextBlock Text="Document:" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="5,5,0,5"/>
                        <TextBox x:Name="RedLineDocumentTextBox" IsEnabled="{Binding IsChecked, ElementName=RedLineCheckBox}" Height="25" Background="{StaticResource ForegroundBrush}" Foreground="Black"/>

                        <TextBlock Text="Page Number:" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="5,10,0,5"/>
                        <TextBox x:Name="RedLinePageNumberTextBox" IsEnabled="{Binding IsChecked, ElementName=RedLineCheckBox}" Height="25" Background="{StaticResource ForegroundBrush}" Foreground="Black"/>

                        <TextBlock Text="Paragraph/Section:" Foreground="{StaticResource ForegroundSecondaryBrush}" Margin="5,10,0,5"/>
                        <TextBox x:Name="RedLineSectionTextBox" IsEnabled="{Binding IsChecked, ElementName=RedLineCheckBox}" Height="25" Background="{StaticResource ForegroundBrush}" Foreground="Black"/>

                        <CheckBox x:Name="RedLineResolvedCheckBox" Content="Resolved" Foreground="{StaticResource ForegroundBrush}" Margin="5,10,0,5"
                                  IsEnabled="{Binding IsChecked, ElementName=RedLineCheckBox}"/>

                        <StackPanel x:Name="RedLineSubCommentPanel" Visibility="Collapsed">
                            <TextBlock Text="RedLine Comments:" Foreground="{StaticResource ForegroundBrush}" FontWeight="SemiBold" Margin="0,15,0,5"/>
                            <TextBox x:Name="RedLineSubCommentTextBox" Height="40" TextWrapping="Wrap" IsEnabled="{Binding IsChecked, ElementName=RedLineCheckBox}"/>

                            <Button Style="{StaticResource AddCommentButtonStyle}" Click="AddRedLineComment_Click" IsEnabled="{Binding IsChecked, ElementName=RedLineCheckBox}" Margin="0,5,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,5,0"/>
                                    <TextBlock Text="Add New Comment" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <StackPanel x:Name="RedLineSubCommentList" />
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
            
                </Grid>

                <Button Content="Save Comment" 
                        x:Name="SaveCommentButton"
                        Background="{StaticResource AccentBrush}" 
                        Foreground="{StaticResource ForegroundBrush}" 
                        FontWeight="Bold"
                        Margin="0,30,0,10"
                        Height="40"
                        Click="SaveCommentButton_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>